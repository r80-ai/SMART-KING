<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/pen_subtoolbar_container"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="#1E293B"
    android:padding="8dp">

    <!-- Sub-Tool Selector Tabs: Pen | Highlight | Shapes | Eraser -->
    <LinearLayout
        android:id="@+id/pen_subtool_selector"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:weightSum="4">

        <TextView
            android:id="@+id/btn_subtool_pen"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1"
            android:gravity="center"
            android:text="Pen"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:textStyle="bold"
            android:background="#334155" />

        <TextView
            android:id="@+id/btn_subtool_highlight"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1"
            android:layout_marginStart="4dp"
            android:gravity="center"
            android:text="Highlight"
            android:textColor="#94A3B8"
            android:textSize="12sp"
            android:background="#0F172A" />

        <TextView
            android:id="@+id/btn_subtool_shapes"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1"
            android:layout_marginStart="4dp"
            android:gravity="center"
            android:text="Shapes"
            android:textColor="#94A3B8"
            android:textSize="12sp"
            android:background="#0F172A" />

        <TextView
            android:id="@+id/btn_subtool_eraser"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1"
            android:layout_marginStart="4dp"
            android:gravity="center"
            android:text="Eraser"
            android:textColor="#94A3B8"
            android:textSize="12sp"
            android:background="#0F172A" />
    </LinearLayout>

    <!-- Sub-Tool Dynamic Settings Area -->
    <FrameLayout
        android:id="@+id/pen_subtool_content_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp" />

</LinearLayout>
