<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/pdf_parent_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- PDF Renderer / Canvas View (Lowest Z-order, displays original document page) -->
    <ImageView
        android:id="@+id/pdf_renderer_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitCenter"
        android:adjustViewBounds="true" />

    <!-- Custom Annotation Canvas Overlay View: handles Pen, Highlight, Shapes, and Geometry Eraser -->
    <com.example.ui.screens.AnnotationCanvasOverlayView
        android:id="@+id/annotation_canvas_overlay_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:elevation="8dp" />

    <!-- TextOverlayView placed to naturally draw selectable/editable text boxes above canvas layers -->
    <com.example.ui.screens.TextOverlayView
        android:id="@+id/text_overlay_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:elevation="16dp" />

</FrameLayout>
